# Plantilla de entorno del backend (FastAPI + bot).
# Copia este archivo a services/.env y ajusta. start_dev.sh lo crea solo si falta.
#
# Dev local: Postgres del docker-compose.yml (puerto 5433).
# Prod: Cloud SQL de Data Connect (DATABASE_URL con unix socket).

DATABASE_URL=postgresql+psycopg2://prontoapp:prontoapp@localhost:5433/prontoapp
# DB separada para los tests (mismo contenedor):
TEST_DATABASE_URL=postgresql+psycopg2://prontoapp:prontoapp@localhost:5433/prontoapp_test

# Secreto compartido API <-> cliente (header X-Secret / dart-define API_SECRET).
# Vacío en dev = la API NO exige el header (la app y el bot conectan sin secreto).
# En prod: poner el secreto real (entregado en privado).
TELEGRAM_WEBHOOK_SECRET=

# Clave para firmar los JWT de la app (HS256). Mínimo 32 bytes (la API falla si es menor).
# En prod: secreto fuerte y privado (p.ej. `openssl rand -hex 32`). La API no puede emitir tokens si está vacía.
JWT_SECRET=dev-jwt-secret-cambiar-en-prod-min-32-bytes

# --- Bot de Telegram (opcional en dev) ---
# Sin TELEGRAM_BOT_TOKEN, start_dev.sh omite el bot; la API + app + DB igual levantan.
# Tokens reales se entregan en privado.
TELEGRAM_BOT_TOKEN=
DEEPSEEK_API_KEY=
# URL de la API que consume el bot:
FASTAPI_URL=http://localhost:5050
# Negocio (tenant) que atiende el bot:
BOT_NEGOCIO_ID=main
